{
  "name": "omp-code",
  "displayName": "OMP Code",
  "description": "%extension.description%",
  "version": "0.17.0",
  "publisher": "cryptotyan-star",
  "author": "Ilona Pushilina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cryptotyan-star/omp-code-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/cryptotyan-star/omp-code-vscode/issues"
  },
  "homepage": "https://github.com/cryptotyan-star/omp-code-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "chat",
    "coding agent",
    "omp",
    "oh-my-pi",
    "claude",
    "anthropic",
    "glm",
    "qwen",
    "kimi"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:ompcode.chat",
    "onView:ompcode.board",
    "onWebviewPanel:ompcode.chatTab"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ompcode",
          "title": "OMP Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ompcode": [
        {
          "type": "webview",
          "id": "ompcode.chat",
          "name": "%view.chat.name%"
        },
        {
          "type": "webview",
          "id": "ompcode.board",
          "name": "%view.board.name%"
        },
        {
          "id": "ompcode.sessions",
          "name": "%view.sessions.name%"
        },
        {
          "id": "ompcode.review",
          "name": "%view.review.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ompcode.openChat",
        "title": "%command.openChat.title%",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon-dark.svg"
        }
      },
      {
        "command": "ompcode.showHistory",
        "title": "%command.showHistory.title%"
      },
      {
        "command": "ompcode.newSession",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "ompcode.setAnthropicKey",
        "title": "%command.setAnthropicKey.title%"
      },
      {
        "command": "ompcode.setKimiKey",
        "title": "%command.setKimiKey.title%"
      },
      {
        "command": "ompcode.setGlmKey",
        "title": "%command.setGlmKey.title%"
      },
      {
        "command": "ompcode.setOpenAiKey",
        "title": "%command.setOpenAiKey.title%"
      },
      {
        "command": "ompcode.setQwenKey",
        "title": "%command.setQwenKey.title%"
      },
      {
        "command": "ompcode.setBigModelKey",
        "title": "%command.setBigModelKey.title%"
      },
      {
        "command": "ompcode.loginClaude",
        "title": "%command.loginClaude.title%"
      },
      {
        "command": "ompcode.loginKimi",
        "title": "%command.loginKimi.title%"
      },
      {
        "command": "ompcode.diagnostics",
        "title": "%command.diagnostics.title%"
      },
      {
        "command": "ompcode.clearKeys",
        "title": "%command.clearKeys.title%"
      },
      {
        "command": "ompcode.setProviderKey",
        "title": "%command.setProviderKey.title%"
      },
      {
        "command": "ompcode.openModelsConfig",
        "title": "%command.openModelsConfig.title%"
      },
      {
        "command": "ompcode.restart",
        "title": "%command.restart.title%"
      },
      {
        "command": "ompcode.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ompcode.exportTranscript",
        "title": "%command.exportTranscript.title%"
      },
      {
        "command": "ompcode.sessionReveal",
        "title": "%command.sessionReveal.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ompcode.sessionAbort",
        "title": "%command.sessionAbort.title%",
        "icon": "$(stop)"
      },
      {
        "command": "ompcode.sessionClose",
        "title": "%command.sessionClose.title%",
        "icon": "$(close)"
      },
      {
        "command": "ompcode.subagentTranscript",
        "title": "%command.subagentTranscript.title%",
        "icon": "$(output)"
      },
      {
        "command": "ompcode.workspace.create",
        "title": "%command.workspace.create.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "ompcode.workspace.delete",
        "title": "%command.workspace.delete.title%",
        "icon": "$(trash)"
      },
      {
        "command": "ompcode.workspace.reveal",
        "title": "%command.workspace.reveal.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ompcode.workspace.openTerminal",
        "title": "%command.workspace.openTerminal.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "ompcode.workspace.openInNewWindow",
        "title": "%command.workspace.openInNewWindow.title%",
        "icon": "$(empty-window)"
      },
      {
        "command": "ompcode.workspace.runSetup",
        "title": "%command.workspace.runSetup.title%",
        "icon": "$(play)"
      },
      {
        "command": "ompcode.workspace.runConfigured",
        "title": "%command.workspace.runConfigured.title%",
        "icon": "$(play)"
      },
      {
        "command": "ompcode.workspace.openPort",
        "title": "%command.workspace.openPort.title%",
        "icon": "$(globe)"
      },
      {
        "command": "ompcode.review.openFile",
        "title": "%command.review.openFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ompcode.review.openAll",
        "title": "%command.review.openAll.title%",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "ompcode.review.discardFile",
        "title": "%command.review.discardFile.title%",
        "icon": "$(discard)"
      },
      {
        "command": "ompcode.review.merge",
        "title": "%command.review.merge.title%",
        "icon": "$(git-merge)"
      },
      {
        "command": "ompcode.review.refresh",
        "title": "%command.review.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ompcode.review.deleteLosers",
        "title": "%command.review.deleteLosers.title%",
        "icon": "$(trash)"
      },
      {
        "command": "ompcode.orchestrator.status",
        "title": "%command.orchestrator.status.title%"
      },
      {
        "command": "ompcode.installOrchestratorAgent",
        "title": "%command.installOrchestratorAgent.title%"
      },
      {
        "command": "ompcode.remoteStart",
        "title": "%command.remoteStart.title%"
      },
      {
        "command": "ompcode.remoteOpen",
        "title": "%command.remoteOpen.title%"
      },
      {
        "command": "ompcode.remoteCopyPairing",
        "title": "%command.remoteCopyPairing.title%"
      },
      {
        "command": "ompcode.remoteStartAllSessions",
        "title": "%command.remoteStartAllSessions.title%"
      },
      {
        "command": "ompcode.remoteRefreshPairing",
        "title": "%command.remoteRefreshPairing.title%"
      },
      {
        "command": "ompcode.remoteStatus",
        "title": "%command.remoteStatus.title%"
      },
      {
        "command": "ompcode.remoteStop",
        "title": "%command.remoteStop.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ompcode.newSession",
          "when": "view == ompcode.chat",
          "group": "navigation"
        },
        {
          "command": "ompcode.workspace.create",
          "when": "view == ompcode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ompcode.review.openAll",
          "when": "view == ompcode.review",
          "group": "navigation@1"
        },
        {
          "command": "ompcode.review.refresh",
          "when": "view == ompcode.review",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "ompcode.openChat",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "ompcode.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "9_ompcode@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ompcode.sessionAbort",
          "when": "view == ompcode.sessions && viewItem =~ /^(working|asks)(-closable)?$/",
          "group": "inline@1"
        },
        {
          "command": "ompcode.sessionClose",
          "when": "view == ompcode.sessions && viewItem =~ /^(?!workspace-).+-closable$/",
          "group": "inline@2"
        },
        {
          "command": "ompcode.subagentTranscript",
          "when": "view == ompcode.sessions && viewItem =~ /^subagent-/",
          "group": "inline@1"
        },
        {
          "command": "ompcode.workspace.reveal",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "inline@1"
        },
        {
          "command": "ompcode.workspace.openTerminal",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "inline@2"
        },
        {
          "command": "ompcode.workspace.delete",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "inline@3"
        },
        {
          "command": "ompcode.workspace.openInNewWindow",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "workspace@1"
        },
        {
          "command": "ompcode.workspace.runSetup",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "workspace@2"
        },
        {
          "command": "ompcode.workspace.openPort",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "inline@4"
        },
        {
          "command": "ompcode.workspace.runConfigured",
          "when": "view == ompcode.sessions && viewItem =~ /^workspace-/",
          "group": "workspace@3"
        },
        {
          "command": "ompcode.review.openFile",
          "when": "view == ompcode.review && viewItem == review-file",
          "group": "inline@1"
        },
        {
          "command": "ompcode.review.discardFile",
          "when": "view == ompcode.review && viewItem == review-file",
          "group": "inline@2"
        },
        {
          "command": "ompcode.review.merge",
          "when": "view == ompcode.review && viewItem =~ /^review-workspace/",
          "group": "inline@1"
        },
        {
          "command": "ompcode.review.openAll",
          "when": "view == ompcode.review && viewItem =~ /^review-workspace/",
          "group": "inline@2"
        },
        {
          "command": "ompcode.review.deleteLosers",
          "when": "view == ompcode.review && viewItem =~ /^review-workspace/",
          "group": "review@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ompcode.openChat",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "ompcode.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "ompcode.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "OMP Code",
      "properties": {
        "ompcode.ompPath": {
          "type": "string",
          "default": "omp",
          "description": "%config.ompPath.description%"
        },
        "ompcode.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.language.enumDescriptions.0%",
            "%config.language.enumDescriptions.1%",
            "%config.language.enumDescriptions.2%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "ompcode.customProviders": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.customProviders.markdownDescription%"
        },
        "ompcode.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultModel.markdownDescription%"
        },
        "ompcode.verifyModels": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.verifyModels.markdownDescription%"
        },
        "ompcode.hideStartupNotices": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hideStartupNotices.markdownDescription%"
        },
        "ompcode.resumeLastSession": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.resumeLastSession.markdownDescription%"
        },
        "ompcode.thinkingLevel": {
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "auto"
          ],
          "default": "auto",
          "description": "%config.thinkingLevel.description%"
        },
        "ompcode.approvalMode": {
          "type": "string",
          "enum": [
            "always-ask",
            "write",
            "yolo"
          ],
          "default": "always-ask",
          "enumDescriptions": [
            "%config.approvalMode.enumDescriptions.0%",
            "%config.approvalMode.enumDescriptions.1%",
            "%config.approvalMode.enumDescriptions.2%"
          ],
          "markdownDescription": "%config.approvalMode.markdownDescription%"
        },
        "ompcode.subagentSubscription": {
          "type": "string",
          "enum": [
            "off",
            "progress",
            "events"
          ],
          "enumDescriptions": [
            "%config.subagentSubscription.off%",
            "%config.subagentSubscription.progress%",
            "%config.subagentSubscription.events%"
          ],
          "default": "progress",
          "markdownDescription": "%config.subagentSubscription.markdownDescription%"
        },
        "ompcode.theme": {
          "type": "string",
          "enum": [
            "violet",
            "coral",
            "emerald",
            "amber",
            "magenta"
          ],
          "enumDescriptions": [
            "%config.theme.enumDescriptions.0%",
            "%config.theme.enumDescriptions.1%",
            "%config.theme.enumDescriptions.2%",
            "%config.theme.enumDescriptions.3%",
            "%config.theme.enumDescriptions.4%"
          ],
          "default": "violet",
          "description": "%config.theme.description%"
        },
        "ompcode.accentColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.accentColor.markdownDescription%"
        },
        "ompcode.modelProfiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.modelProfiles.markdownDescription%"
        },
        "ompcode.remoteRelayUrl": {
          "type": "string",
          "default": "wss://my.omp.sh",
          "markdownDescription": "%config.remoteRelayUrl.markdownDescription%"
        },
        "ompcode.worktreeBaseDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.worktreeBaseDir.markdownDescription%"
        },
        "ompcode.workspaceBranchPrefix": {
          "type": "string",
          "default": "omp/",
          "markdownDescription": "%config.workspaceBranchPrefix.markdownDescription%"
        },
        "ompcode.workspaceSetup": {
          "type": "string",
          "enum": [
            "auto",
            "ask",
            "never"
          ],
          "enumDescriptions": [
            "%config.workspaceSetup.enumDescriptions.0%",
            "%config.workspaceSetup.enumDescriptions.1%",
            "%config.workspaceSetup.enumDescriptions.2%"
          ],
          "default": "ask",
          "markdownDescription": "%config.workspaceSetup.markdownDescription%"
        },
        "ompcode.portScan": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.portScan.markdownDescription%"
        },
        "ompcode.portScanIgnore": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [22, 80, 443],
          "markdownDescription": "%config.portScanIgnore.markdownDescription%"
        },
        "ompcode.reviewAutoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.reviewAutoRefresh.markdownDescription%"
        },
        "ompcode.orchestratorTools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.orchestratorTools.markdownDescription%"
        },
        "ompcode.orchestratorMaxWorkspaces": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "markdownDescription": "%config.orchestratorMaxWorkspaces.markdownDescription%"
        },
        "ompcode.costLimitPerWorkspaceUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.costLimitPerWorkspaceUsd.markdownDescription%"
        },
        "ompcode.costLimitPerSessionUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.costLimitPerSessionUsd.markdownDescription%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test --experimental-strip-types test/*.test.ts",
    "package": "vsce package",
    "dist": "npm run package && bash scripts/pack-dist.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.3",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.5"
  }
}
