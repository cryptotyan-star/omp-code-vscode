{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 opens a second VS Code with this extension loaded from dist/.
      // Run `npm run build` first, or the host loads a stale bundle — the
      // launch does not build for you.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
